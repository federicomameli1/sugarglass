<?xml version="1.0" encoding="utf-8"?>
<!-- ponytail: fake glass. Android gives widgets no backdrop blur, so this is a translucent
     panel with a sheen and a rim light rather than real refraction -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_fill" />
            <corners android:radius="24dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#38FFFFFF"
                android:centerColor="#0AFFFFFF"
                android:endColor="#1FFFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke
                android:width="1dp"
                android:color="#61FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
